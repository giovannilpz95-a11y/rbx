{
  "name": "FarmGreybox",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "FarmShared": {
        "$path": "src/shared"
      },
      "UiTheme": {
        "$path": "../uitheme/src"
      }
    },
    "ServerScriptService": {
      "FarmServer": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMinZoomDistance": 10,
        "CameraMaxZoomDistance": 45,
        "CharacterWalkSpeed": 20,
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "FarmClient": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 160,
        "StreamingTargetRadius": 320,
        "StreamOutBehavior": "Opportunistic",
        "ModelStreamingBehavior": "Improved"
      }
    }
  }
}
