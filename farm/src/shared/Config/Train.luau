--!strict
-- The Train Station (Design/05 Train Station, roadmap week 6; Township baseline from the wiki's
-- Train page). The first train pulls in at level 5; two more can be bought at 14 and 25. Each
-- train waits at the platform with cars that each ask for one good. Load the cars you can from
-- the Barn, then send the train off whenever you like: it comes back about 4-5 hours later, and
-- every car that went out loaded brings back the reward it showed on its side (building
-- materials mostly, Barn materials and tools now and then). A train sent with every car loaded
-- brings one reward more. Loading pays XP at once and no Coins (as Township).
--
-- Decided defaults (05 Train Station): no loading window; cars by level as the note; a car's
-- reward is drawn with the car and shown before it's loaded; the bonus for a full train is shown
-- too, so there's no hidden roll.

local MIN = 60
local HOUR = 3600

export type Reward = { item: string, qty: number, weight: number, fromLevel: number }

local function q(low: number, high: number): { number }
	return table.freeze({ low, high })
end

return table.freeze({
	unlockLevel = 5,
	-- From this level one car a train can carry a help flag: neighbors on the server can load it
	-- from their own Barns (05 Train Station: the Help Crate). The helper earns the car's goods
	-- value in Coins times helperCoinMult and its XP; the owner still gets the car's reward.
	helpFromLevel = 7,
	helperCoinMult = 1,
	-- The trains: the level each can be had from and its Coin price (Township: free, 1,000, 14,000)
	trains = table.freeze({
		table.freeze({ level = 5, coins = 0 }),
		table.freeze({ level = 14, coins = 1000 }),
		table.freeze({ level = 25, coins = 14000 }),
	}),
	-- Cars a train brings at a level (05 Train Station: 3 at 5, 4 at 11, 5 at 15)
	cars = table.freeze({
		table.freeze({ level = 5, cars = 3 }),
		table.freeze({ level = 11, cars = 4 }),
		table.freeze({ level = 15, cars = 5 }),
	}),
	-- A trip takes travelMin at the first level and rises to travelMax by travelFullLevel
	-- (Township: 4h 15m to 5h before Academy upgrades)
	travelMin = 4 * HOUR + 15 * MIN,
	travelMax = 5 * HOUR,
	travelFullLevel = 60,

	-- Raw goods (crops and animal goods) are picked this many times as often as factory goods
	-- (05 Train Station: the train is about raw goods; the blimp leans to factory goods)
	rawWeight = 3,
	-- A car asks for the low end of its range at qtyFromLevel, and the top grows to the whole
	-- range by qtyFullLevel (as the Cargo Blimp; first-pass). At the start the top is
	-- qtyStartShare of the way from low to high.
	qtyFromLevel = 5,
	qtyFullLevel = 60,
	qtyStartShare = 0.35,
	-- A good with no train range below asks for its Cargo Blimp crate range divided by this
	blimpDivisor = 4,
	-- XP a loaded car pays: its goods' XP times this (05 Train Station: order XP x 1.5)
	carXpMult = 1.5,

